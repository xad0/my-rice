* {
    bg: #1e1e2e;
    surface: #313244;
    text: #cdd6f4;
    green: #a6e3a1;

    background-color: @bg;
    text-color: @text;
}

window {
    width: 520px;
    padding: 15px;

    background-color: #1e1e2e;

    border: 2px;
    border-color: #a6e3a1;
    border-radius: 16px;
}

mainbox {
    children: [
        inputbar,
        listview
    ];

    spacing: 12px;
}

inputbar {
    background-color: @surface;
    padding: 10px;

    border-radius: 10px;
}

prompt {
    text-color: @green;
}

entry {
    text-color: @text;
}

listview {
    lines: 6;
    spacing: 5px;
}

element {
    padding: 5px;
    border-radius: 8px;

    background-color: transparent;
    text-color: @text;

    children: [
        element-icon,
        element-text
    ];
}

element normal {
    background-color: transparent;
    text-color: @text;
}

element alternate {
    background-color: transparent;
    text-color: @text;
}

element selected {
    background-color: #313244;
    text-color: @green;

    border: 2px;
    border-color: #a6e3a1;
    border-radius: 8px;
}

element-icon {
    size: 28px;
}

element-text {
    text-color: @text;
}
