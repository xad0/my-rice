{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,

    "modules-left": ["hyprland/language",  "hyprland/workspaces", "custom/rmpc"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "cpu", "memory", "battery", "tray"],

    "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": {
        "*": 3
    }

    },
    
     "hyprland/language": {
     "format": "{short}",
     "min-length": 0,
     "max-length": 2,
     "tooltip": false
    },

    "custom/rmpc": {
        "exec": "~/.config/waybar/rmpc.sh",
        "return-type": "json",
        "interval": 1,
        "hide-empty-text": true,
        "on-click": "/home/adomas/.config/waybar/rmpc-popup-toggle.sh"
    },

    "clock": {
        "format": "{:%a %d/%m/%Y - %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪 disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
            "scroll-step": 5,
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "󰘚 {percentage}%"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
        "format-charging": "󰂄 {capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}
